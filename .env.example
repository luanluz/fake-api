# Application
APP_NAME=Fake API
APP_VERSION=1.0.0
HOST=localhost
PORT=3000
# Optional: override URL used in RFC 7807 `type` fields (e.g. behind a proxy)
# BASE_URL=http://localhost:3000
#
# Docker (docker-compose sets these automatically):
# HOST=0.0.0.0
# BASE_URL=http://localhost:3000

# Auth
JWT_SECRET=fake-api-secret
JWT_EXPIRES_IN=7d
SEED_PASSWORD=password123

# Pagination defaults
PAGINATION_DEFAULT_PAGE=1
PAGINATION_DEFAULT_LIMIT=10
PAGINATION_MAX_LIMIT=100
